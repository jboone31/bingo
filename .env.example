# ---------------------------------------------------------------------------
# Bingo Draft: environment configuration (EXAMPLE / template)
# ---------------------------------------------------------------------------
# This file is COMMITTED and contains only placeholder values. Copy it to a real,
# uncommitted env file and fill in actual values:
#
#   local        ->  .env.local        (your machine / dev Supabase project)
#   preview      ->  Vercel "Preview"  environment variables
#   production   ->  Vercel "Production" environment variables
#
# All real env files are git-ignored. NEVER put real secrets in this file.
# ---------------------------------------------------------------------------

# --- Public (browser-safe) -------------------------------------------------
# Exposed to the client bundle. Safe to ship; access is scoped by Row-Level
# Security.

# Base URL of the Supabase project (https://<project-ref>.supabase.co).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key. NOT the service-role key.
# Either name works; NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY wins if both are set.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server-only (NEVER sent to the browser) -------------------------------
# Never prefix these with NEXT_PUBLIC_.

# Supabase service-role key. Bypasses Row-Level Security. Treat as a secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string for transaction-capable server writes. On Vercel
# use the Supabase pooler in TRANSACTION mode (port 6543), because serverless
# functions open many short connections. Locally, the session pooler or direct
# connection also works.
SUPABASE_DB_URL=postgres://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Shared secret protecting cron/maintenance routes (the draft timer backstop).
# Generate a long random value, e.g. `openssl rand -hex 32`.
CRON_SECRET=your-long-random-secret
